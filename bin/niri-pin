#!/usr/bin/env python3
# Тримає вибрані вікна на тому робочому столі niri, який зараз відкритий:
# перемкнувся на інший стіл — вікно переїжджає слідом (фокус не забирає).
# Список програм (app-id, регулярні вирази) — у PINNED нижче.
# Запуск: niri-pin (з config через spawn-at-startup). Лог: ~/.cache/niri-pin.log
import json, os, re, subprocess

PINNED = [r"^steam_app_3339420$"]          # Your Wife
pat = re.compile("|".join(PINNED))


def niri_json(*args):
    return json.loads(subprocess.run(["niri", "msg", "-j", *args], capture_output=True, text=True).stdout)


def sync():
    ws = niri_json("workspaces")
    cur = next((w for w in ws if w["is_focused"]), None)
    if not cur:
        return
    for w in niri_json("windows"):
        if pat.search(w.get("app_id") or "") and w["workspace_id"] != cur["id"]:
            subprocess.run(["niri", "msg", "action", "move-window-to-workspace",
                            "--window-id", str(w["id"]), "--focus", "false", str(cur["idx"])],
                           capture_output=True)


TOAST = re.compile(r"^notificationtoasts")      # спливаючі сповіщення Steam (друг у мережі, досягнення...)
placed = set()


def place_toast(w):
    """Сповіщення Steam — у правий нижній кут (12 px від країв), як на Windows.
    Steam спершу відкриває вікно без потрібної назви, тому правило niri з позицією не спрацьовує —
    ставимо вручну, щойно назва з'явилась. Зсув відносний: так не залежить від панелі зверху."""
    if w["id"] in placed or (w.get("app_id") or "") != "steam" or not TOAST.search(w.get("title") or ""):
        return
    if not w.get("is_floating"):
        # правило niri не спрацювало при відкритті — вікно лягло плиткою; робимо плаваючим
        subprocess.run(["niri", "msg", "action", "toggle-window-floating", "--id", str(w["id"])], capture_output=True)
        w = next((x for x in niri_json("windows") if x["id"] == w["id"]), None)
        if not w:
            return
    L = w["layout"]
    pos = L.get("tile_pos_in_workspace_view")
    if not pos:
        return
    out = next(iter(niri_json("outputs").values()))["logical"]
    tw, th = L["tile_size"]
    dx = int(out["width"] - tw - 12 - pos[0])
    dy = int(out["height"] - th - 12 - pos[1])
    if dx or dy:
        subprocess.run(["niri", "msg", "action", "move-floating-window", "--id", str(w["id"]),
                        "-x", f"{dx:+d}", "-y", f"{dy:+d}"], capture_output=True)
    placed.add(w["id"])


GAME = "steam_app_3339420"
HIDE = 'vec4 window_color(vec3 coords_geo, vec3 size_geo) { return vec4(0.0); }'
game_seen = {}     # id вікна гри без назви -> що вже зроблено
menus = []         # відкриті меню гри (id, x, y, w, h) — підменю ставимо праворуч від попереднього


def act(*a):
    subprocess.run(["niri", "msg", "action", *a], capture_output=True)


def handle_game_untitled(w):
    """Вікна Your Wife без назви: смужка трею Wine (160x20) — невидима в правому нижньому куті;
    решта — меню гри (рідне PopupMenu): плаваюче, біля курсора, підменю — праворуч від батьківського."""
    if (w.get("app_id") or "") != GAME or w.get("title"):
        return
    wid = w["id"]
    size = tuple(w["layout"].get("window_size") or (0, 0))
    if size == (160, 20):
        if game_seen.get(wid) != "tray":
            subprocess.run(["niri", "msg", "window-shader", "set", "--id", str(wid), HIDE], capture_output=True)
            game_seen[wid] = "tray"
        return
    if game_seen.get(wid) == "menu" or size[0] < 30:
        return
    game_seen[wid] = "menu"
    if not w.get("is_floating"):
        act("toggle-window-floating", "--id", str(wid))
    out = next(iter(niri_json("outputs").values()))["logical"]
    sw, sh = out["width"], out["height"]
    cx, cy = json.loads(subprocess.run(["niri", "msg", "-j", "cursor-position"], capture_output=True, text=True).stdout or "[0,0]")
    alive = {x["id"] for x in niri_json("windows")}
    menus[:] = [m for m in menus if m[0] in alive]
    if menus:
        px, py, pw, ph = menus[-1][1:]
        x, y = px + pw - 6, cy - 20
        if x + size[0] > sw:
            x = px - size[0] + 6
    else:
        x, y = cx + 2, cy + 2
    x = min(max(x, 0), sw - size[0]); y = min(max(y, 0), sh - size[1])
    cur = next((x2 for x2 in niri_json("windows") if x2["id"] == wid), None)
    pos = (cur or w)["layout"].get("tile_pos_in_workspace_view") or (0, 0)
    act("move-floating-window", "--id", str(wid), "-x", f"{int(x - pos[0]):+d}", "-y", f"{int(y - pos[1]):+d}")
    menus.append((wid, x, y, size[0], size[1]))


def main():
    try:
        sync()
    except Exception:
        pass
    p = subprocess.Popen(["niri", "msg", "-j", "event-stream"], stdout=subprocess.PIPE, text=True)
    for line in p.stdout:
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        try:
            if "WorkspaceActivated" in ev and ev["WorkspaceActivated"].get("focused"):
                sync()
            elif "WindowOpenedOrChanged" in ev:
                w = ev["WindowOpenedOrChanged"]["window"]
                if pat.search(w.get("app_id") or ""):
                    sync()
                if (w.get("app_id") or "") == "steam":
                    with open(os.path.expanduser("~/.cache/niri-pin.log"), "a") as f:
                        f.write(f'{w["id"]} {w.get("title")!r} float={w.get("is_floating")} {w["layout"].get("window_size")}\n')
                place_toast(w)
                handle_game_untitled(w)
            elif "WindowClosed" in ev:
                placed.discard(ev["WindowClosed"]["id"])
                game_seen.pop(ev["WindowClosed"]["id"], None)
        except Exception:
            pass


if __name__ == "__main__":
    import sys, time
    if "--once" in sys.argv:
        main()
    else:
        # вічний цикл: якщо щось упало (niri перезапустився, помилка) — через 2 с знову
        while True:
            try:
                main()
            except Exception:
                pass
            time.sleep(2)
