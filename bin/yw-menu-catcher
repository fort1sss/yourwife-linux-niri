#!/usr/bin/env python3
# Your Wife: поки відкрите меню гри — прозорий шар на весь екран ПІД вікнами (шар bottom niri).
# Клік по порожньому робочому столу (шпалерах) закриває меню гри. Запускає й прибирає niri-pin.
import os, sys

LS = "/usr/lib/libgtk4-layer-shell.so"
if os.path.exists(LS) and LS not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = LS          # gtk4-layer-shell мусить завантажитись раніше за libwayland
    os.execv(sys.executable, [sys.executable] + sys.argv)

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gtk, Gdk
from gi.repository import Gtk4LayerShell as L

CMD = os.path.expanduser("~/.local/share/Steam/steamapps/compatdata/3339420/pfx/drive_c/users/steamuser/"
                         "AppData/Roaming/Godot/app_userdata/你的老婆/linux_cmd.txt")


def close_menu(*_):
    try:
        with open(CMD, "a") as f:
            f.write("closemenu\n")
    except OSError:
        pass
    app.quit()


def activate(app):
    css = Gtk.CssProvider()
    css.load_from_string("window { background: transparent; }")
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, 800)
    w = Gtk.Window(application=app)
    L.init_for_window(w)
    L.set_layer(w, L.Layer.BOTTOM)
    L.set_namespace(w, "yourwife-menu-catcher")
    for e in (L.Edge.TOP, L.Edge.BOTTOM, L.Edge.LEFT, L.Edge.RIGHT):
        L.set_anchor(w, e, True)
    L.set_exclusive_zone(w, -1)
    L.set_keyboard_mode(w, L.KeyboardMode.NONE)
    click = Gtk.GestureClick(button=0)
    click.connect("pressed", close_menu)
    w.add_controller(click)
    w.present()


app = Gtk.Application(application_id="org.vi.yourwife.menucatcher")
app.connect("activate", activate)
app.run(None)
