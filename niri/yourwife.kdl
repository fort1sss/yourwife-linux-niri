// Your Wife (Steam 3339420) on niri + niri-shaders.
// Include from ~/.config/niri/config.kdl:   include "yourwife.kdl"
// Lines marked "needs-patch" need niri built with patches/niri-yourwife.patch;
// install.sh drops them automatically when the running niri does not know them.

// True transparency: Wine ScreenDepth=32 (set by install.sh) gives the game ARGB windows.
// Fallback for setups where that fails: uncomment the magenta-key shader and delete user://linux_alpha.
window-rule {
    match app-id="^steam_app_3339420$"
    // shader "shaders/magenta-key.frag" { uniform "tolerance" 0.3; uniform "outline_px" 0.0; uniform "outline_color" 0.85 0.85 0.85 0.9; }
    border { off; }
    shadow { off; }
    focus-ring { off; }
    draw-border-with-background false
    // the game resizes its window itself — no niri animation, otherwise the character doubles
    no-resize-animation true // needs-patch
    // stay visible and clickable above fullscreen windows (video, games) and above other floating
    // windows, like "always on top" on Windows; the game's own windows keep their order among themselves
    above-fullscreen true // needs-patch
}

// The character's own window (its title arrives from Wine as "???? ???????"): clicks and scrolls reach her,
// but she never becomes the focused window, so Mod+F, Mod+M etc. keep acting on your window.
window-rule {
    match app-id="^steam_app_3339420$" title=r"^\?{4} \?{7}$"
    open-focused false
    no-focus true // needs-patch
    // Wine asks to activate the window on every click (SetForegroundWindow) — ignore it
    on-xdg-activate "ignore"
}

// Untitled game windows: Wine's fallback tray strip (160x20, niri-pin makes it invisible) and the game's
// right-click menus (native Godot PopupMenu; niri-pin places them at the cursor). All of them float.
window-rule {
    match app-id="^steam_app_3339420$" title="^$"
    open-floating true
    open-focused true
    default-floating-position x=0 y=0 relative-to="bottom-right"
}

// Steam notification toasts -> bottom-right (niri-pin finishes the job when Steam sets the title late).
window-rule {
    match app-id="^steam$" title="^notificationtoasts"
    open-floating true
    open-focused false
    default-floating-position x=12 y=12 relative-to="bottom-right"
    border { off; }
    shadow { off; }
}

// Separate X server only for the game (Steam launch options: DISPLAY=:2 %command%),
// so Steam's X window does not steal hover from the character.
spawn-at-startup "xwayland-satellite" ":2"
// Character follows you across workspaces; Steam toasts placement (restarts itself if it dies).
spawn-sh-at-startup "while true; do @BIN@/niri-pin; sleep 2; done"
// Eyes follow the cursor over the whole screen + window size sync for the game (restarts itself).
spawn-sh-at-startup "while true; do @BIN@/yw-gaze; sleep 2; done"
// Tray icon in waybar (StatusNotifierItem): left click — game menu, right click — actions (restarts itself).
spawn-sh-at-startup "while true; do @BIN@/yw-tray; sleep 2; done"

// "Start with the system" from the game's settings (flag file linux_autostart in the game's user dir)
spawn-sh-at-startup "sleep 6; [ -e \"$HOME/.local/share/Steam/steamapps/compatdata/3339420/pfx/drive_c/users/steamuser/AppData/Roaming/Godot/app_userdata/你的老婆/linux_autostart\" ] && @BIN@/yourwife start"


// Hotkeys (hide/show, open menu) are generated by yw-gaze from the game's settings into
// ~/.config/niri/yourwife-keys.kdl — install.sh adds:  include "yourwife-keys.kdl"
