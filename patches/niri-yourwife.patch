+    /// Windows with the above-fullscreen rule stay on top of the other floating windows; among
+    /// themselves they keep their order (so e.g. a companion's own menu stays above it).
+    fn keep_above_fullscreen_on_top(&mut self) {
+        let pinned = |t: &Tile<W>| t.window().rules().above_fullscreen == Some(true);
+        // Already ordered: no pinned tile after an unpinned one.
+        let first_unpinned = self.tiles.iter().position(|t| !pinned(t));
+        let misplaced = match first_unpinned {
+            Some(i) => self.tiles[i..].iter().any(pinned),
+            None => false,
+        };
+        if !misplaced {
+            return;
+        }
+        let mut order: Vec<usize> = (0..self.tiles.len()).collect();
+        order.sort_by_key(|&i| !pinned(&self.tiles[i]));
+        let mut tiles: Vec<Option<Tile<W>>> = self.tiles.drain(..).map(Some).collect();
+        let mut data: Vec<Option<Data>> = self.data.drain(..).map(Some).collect();
+        for i in order {
+            self.tiles.push(tiles[i].take().unwrap());
+            self.data.push(data[i].take().unwrap());
+        }
+    }
+
